generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
  DRAWN
  CANCELLED
}

enum TicketStatus {
  VALID
  REFUNDED
  CANCELLED
  WINNER
}

enum TicketSource {
  PURCHASE
  FREE_ENTRY
  MANUAL
}

enum AuditActionType {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  DRAW
  IMPORT
  EXPORT
}

enum FreeEntryStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Shop {
  id            String        @id @default(cuid())
  shopDomain    String        @unique
  installedAt   DateTime      @default(now())
  uninstalledAt DateTime?
  isInstalled   Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  raffles       Raffle[]
  orders        ShopifyOrder[]
  auditLogs     AuditLog[]
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?
  emailVerified Boolean?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Raffle {
  id                   String         @id @default(cuid())
  shopId               String
  title                String
  slug                 String
  description          String?
  status               RaffleStatus   @default(DRAFT)
  startDate            DateTime?
  endDate              DateTime?
  maxTickets           Int
  soldTicketsCount     Int            @default(0)
  remainingTicketsCount Int?
  freeEntryEnabled     Boolean        @default(false)
  drawLockedAt         DateTime?
  drawnAt              DateTime?
  winnerTicketId       String?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  shop                 Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  raffleProducts       RaffleProduct[]
  tickets              Ticket[]
  freeEntries          FreeEntry[]
  drawReports          DrawReport[]
  winnerTicket         Ticket?        @relation("RaffleWinnerTicket", fields: [winnerTicketId], references: [id], onDelete: SetNull)

  @@unique([shopId, slug])
  @@index([shopId])
  @@index([slug])
  @@index([status])
  @@index([createdAt])
}

model RaffleProduct {
  id               String   @id @default(cuid())
  raffleId         String
  shopifyProductId String
  shopifyVariantId String?
  title            String?
  variantTitle     String?
  ticketsPerUnit   Int
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  raffle           Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([raffleId, shopifyProductId, shopifyVariantId])
  @@index([raffleId])
  @@index([createdAt])
}

model ShopifyOrder {
  id                 String    @id @default(cuid())
  shopId             String
  shopifyOrderId     String    @unique
  shopifyOrderNumber String?
  customerId         String?
  customerEmail      String?
  financialStatus    String?
  fulfillmentStatus  String?
  totalPrice         Decimal?  @db.Decimal(12, 2)
  currency           String?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  shop               Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  tickets            Ticket[]

  @@index([shopId])
  @@index([customerEmail])
  @@index([financialStatus])
  @@index([createdAt])
}

model Ticket {
  id            String       @id @default(cuid())
  raffleId      String
  orderId       String?
  customerId    String?
  customerEmail String?
  ticketNumber  Int
  status        TicketStatus @default(VALID)
  source        TicketSource @default(PURCHASE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  raffle        Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  order         ShopifyOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  winnerForRaffles Raffle[]  @relation("RaffleWinnerTicket")
  drawReports   DrawReport[]

  @@unique([raffleId, ticketNumber])
  @@index([raffleId])
  @@index([orderId])
  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
}

model FreeEntry {
  id         String          @id @default(cuid())
  raffleId   String
  email      String
  firstname  String?
  lastname   String?
  address    String?
  ipHash     String?
  status     FreeEntryStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  raffle     Raffle          @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@index([raffleId])
  @@index([email])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id         String          @id @default(cuid())
  shopId     String
  actorType  String?
  actorId    String?
  action     AuditActionType
  entityType String
  entityId   String?
  payloadJson Json?
  createdAt  DateTime        @default(now())
  shop       Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

model DrawReport {
  id                  String    @id @default(cuid())
  raffleId            String
  winnerTicketId      String?
  ticketsSnapshotHash String?
  ticketsSnapshotPath String?
  drawnAt             DateTime
  createdAt           DateTime  @default(now())
  raffle              Raffle    @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  winnerTicket        Ticket?   @relation(fields: [winnerTicketId], references: [id], onDelete: SetNull)

  @@index([raffleId])
  @@index([winnerTicketId])
  @@index([drawnAt])
  @@index([createdAt])
}
